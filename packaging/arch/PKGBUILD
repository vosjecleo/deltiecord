pkgname=deltiecord
pkgver=0.9.23
pkgrel=74
pkgdesc='Compact Matrix desktop client'
arch=('x86_64')
url='https://deltie.net/cord'
license=('AGPL-3.0-or-later')
options=('!debug' '!lto')
depends=('gtk3' 'libsecret' 'libpulse' 'alsa-lib' 'libv4l' 'mpv' 'pipewire' 'xdg-desktop-portal')
makedepends=('flutter' 'cmake' 'clang' 'ninja')
source=()
sha256sums=()

pkgver() {
  sed -n 's/^version: \([^+]*\).*/\1/p' "$startdir/../../pubspec.yaml"
}

build() {
  cd "$startdir/../.."
  # makepkg supplies its own RUSTFLAGS, so append rather than defaulting.
  export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C link-dead-code"
  flutter pub get
  flutter build linux --release
  packaging/linux/verify-release.sh
}

package() {
  cd "$startdir/../.."
  local bundle='build/linux/x64/release/bundle'
  install -d "$pkgdir/usr/lib/deltiecord" "$pkgdir/usr/bin"
  cp -a "$bundle/." "$pkgdir/usr/lib/deltiecord/"
  install -Dm755 packaging/linux/deltiecord-launcher \
    "$pkgdir/usr/bin/deltiecord"
  install -Dm644 packaging/linux/net.deltie.deltiecord.desktop \
    "$pkgdir/usr/share/applications/net.deltie.deltiecord.desktop"
  install -Dm644 packaging/linux/net.deltie.deltiecord.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/net.deltie.deltiecord.png"
  install -Dm644 packaging/linux/net.deltie.deltiecord.metainfo.xml \
    "$pkgdir/usr/share/metainfo/net.deltie.deltiecord.appdata.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/deltiecord/LICENSE"
  install -Dm644 CREDITS.md "$pkgdir/usr/share/doc/deltiecord/CREDITS.md"
  install -Dm644 THIRD-PARTY-NOTICES.md \
    "$pkgdir/usr/share/doc/deltiecord/THIRD-PARTY-NOTICES.md"
  install -Dm644 "$bundle/data/flutter_assets/NOTICES.Z" \
    "$pkgdir/usr/share/doc/deltiecord/FLUTTER-NOTICES.Z"
}
